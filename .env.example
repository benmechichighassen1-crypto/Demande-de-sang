APP_NAME="Demandes de sang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base propre à l'application (tables ds_*, sessions, cache) : à créer une fois.
DB_CONNECTION=sqlsrv
DB_HOST=192.168.1.154
DB_PORT=1433
DB_DATABASE=demandesang_app
DB_USERNAME=
DB_PASSWORD=

# Clinisys en LECTURE SEULE (compte db_datareader).
CLINISYS_ACTIF=true
CLINISYS_HOST=192.168.1.154
CLINISYS_PORT=1433
CLINISYS_DATABASE=Gclinique_Maroc
CLINISYS_USERNAME=
CLINISYS_PASSWORD=
CLINISYS_BASE_ERP=Gclinique_Maroc
# Base du module pharmacie (à confirmer ; par défaut la même que l'ERP).
CLINISYS_BASE_PHARMACIE=
# Préfixe de serveur lié, ex. [SRV_ERP] ; vide = connexion directe.
CLINISYS_PREFIXE=
# Schéma de hachage AccessControl (même valeur que l'appli oncologie).
CLINISYS_HASH=auto

# Logins administrateurs de l'application, séparés par des virgules.
DS_ADMINS=

SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=database
QUEUE_CONNECTION=sync
