        <mxCell id="lRTdVrlz4UCD_535S1VD-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;fontSize=15;fontStyle=1" value="Cas de patient hospitalisé - Demande de sang hors hospitalisation&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="498" x="32" y="70" as="geometry" />
        </mxCell>
        <mxCell id="lRTdVrlz4UCD_535S1VD-80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;p&gt;Lorsqu’un patient hospitalisé nécessite une transfusion sanguine en dehors de son séjour d’hospitalisation, la demande de sang ne doit pas être effectuée dans le dossier d’hospitalisation initial.&lt;/p&gt;&lt;p&gt;Le patient est alors considéré comme un patient externe. Un second dossier est créé spécifiquement pour la demande de sang, puis conservé en instance jusqu’à la prise en charge effective du patient et la réalisation de la transfusion.&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="746" x="32" y="150" as="geometry" />
        </mxCell>
