        <mxCell id="9FrS2RjpNMwYF-BBLZ4l-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;h6 style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;NB : Toute&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;réception de poche de sang doivent être enregistrées dans le système&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;d’information CLINISYS et le registre destiné à cet effet.&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Toute demande de sang adressée au Centre de&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;transfusion sanguine doit comporter deux fiches de demande de sang : une fiche&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;imprimée à partir du système CLINISYS et une fiche issue du registre du Centre&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; font-size: 12px;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;de transfusion sanguine.&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Pour chaque demande, le coursier doit&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;conserver la fiche de demande imprimée à partir de CLINISYS jusqu’à la&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;réception de la poche de sang. Il doit ensuite remettre cette fiche au&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;surveillant général.&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Le surveillant général est tenu de contacter&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;les patients dont les poches de sang ont été livrées afin de les en informer.&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;/h6&gt;&lt;p&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
